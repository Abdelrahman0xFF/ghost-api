{
    "manifest_version": 3,
    "name": "Ghost API",
    "version": "1.0.0",
    "author": "Abdelrahman Ashraf",
    "offline_enabled": true,
    "description": "Capture JSON and FormData payloads in real-time.",
    "permissions": ["sidePanel"],
    "host_permissions": ["<all_urls>"],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Open Sniffer",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "side_panel": {
        "default_path": "panel.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["sniffer.js"],
            "matches": ["<all_urls>"]
        }
    ]
}
